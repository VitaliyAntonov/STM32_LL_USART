void USART3_IRQHandler(void)
{
  if((UART->SR & (USART_SR_ORE | USART_SR_PE | USART_SR_FE | USART_SR_NE)) != 0){
    uartVal.errByte = (uint8_t) LL_USART_ReceiveData8(UART);
    if (LL_USART_IsActiveFlag_ORE(UART)) { // Over run error
      uartVal.errorFlag = TRANSIT_EC_FLAG_ORE;
      LL_USART_ClearFlag_ORE(UART);
    } else if (LL_USART_IsActiveFlag_PE(UART)) { // Parity error
      uartVal.errorFlag = TRANSIT_EC_FLAG_PE;
      LL_USART_ClearFlag_PE(UART);
    } else if (LL_USART_IsActiveFlag_FE(_UART)) { // Framing error
      uartVal.errorFlag = TRANSIT_EC_FLAG_FE;
      LL_USART_ClearFlag_FE(UART);
    } else if (LL_USART_IsActiveFlag_NE(_UART)) { // Noise error
      uartVal.errorFlag = TRANSIT_EC_FLAG_NE;
      LL_USART_ClearFlag_NE(UART);
    }
  } else if (LL_USART_IsActiveFlag_RXNE(UART)) {
    /** ============ Получен байт ============== */
    uartVal.buff[uartVal.count] = (uint8_t) LL_USART_ReceiveData8(UART);
    LL_USART_ClearFlag_RXNE(UART);


    __UART_in_gran(UART_WAIT_PACK_HEADER)


    __UART_close_gran_in_gran(UART_READ_BAIT)

        uartVal.crc = tabCrc_D5[uartVal.crc ^ uartVal.buff[uartVal.count]];
        uartVal.count += 1;

    __UART_close_gran_in_gran(UART_CHECK_CRC)


    __UART_end_gran_end_process()
    

  }
}

/** Функция отправляет TX буфер по UART */
void transmitTxBufferUart3(void){

  for(uartVal.countTx = 0; uartVal.countTx < LENGTH_TX_UART_BUFFER; uartVal.countTx += 1){
    LL_USART_TransmitData8(UART, (uint16_t)uartVal.buffTx[uartVal.countTx]);
    while (!LL_USART_IsActiveFlag_TXE(UART)){};
  }

}









